# Production builds already use the backend (.env.production). Copy this to .env.local to make
# `npm run dev` use it too: real accounts instead of the phone-only test logins.
# Without these, dev reads public/data/ and uses phone-only accounts.
# VITE_DATA_SOURCE=api
# VITE_API_URL=https://bulig-backend.onrender.com/api/v1
# Local backend instead (php artisan serve):
# VITE_API_URL=http://localhost:8000/api/v1
