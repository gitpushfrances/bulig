# Production builds (npm run build: Cloudflare live and previews) talk to the backend.
# Places, numbers and accounts come from the API; public/data/ is only the offline fallback.
# A variable set in the Cloudflare dashboard wins over this file. `npm run dev` and the tests
# don't read it, so they keep the bundled files and phone-only test logins.
VITE_DATA_SOURCE=api
VITE_API_URL=https://bulig-backend.onrender.com/api/v1
