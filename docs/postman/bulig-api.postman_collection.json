    {
      "name": "2. Accounts",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "description": "201 with token. 422 errors.email = already registered: run Login instead.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Test\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"acceptedTerms\": true,\n  \"device\": \"Postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const ok = pm.response.code === 200 || pm.response.code === 201;",
                  "pm.test('signed in', () => pm.expect(ok).to.be.true);",
                  "if (ok) { pm.collectionVariables.set('token', pm.response.json().token); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "description": "422 = wrong email or password. 403 reason \"suspended\". 429 = too many tries (10/min).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"device\": \"Postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const ok = pm.response.code === 200 || pm.response.code === 201;",
                  "pm.test('signed in', () => pm.expect(ok).to.be.true);",
                  "if (ok) { pm.collectionVariables.set('token', pm.response.json().token); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Forgot password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
